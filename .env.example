# Copie para .env (que o Git ignora) e preencha. Nunca versione o .env real.
#   cp .env.example .env

# Usuário e senha que o MySQL do compose cria para a API.
DB_USERNAME=solveit
DB_PASSWORD=

# Chave de assinatura dos tokens: Base64 com pelo menos 32 bytes. Gere uma com:
#   openssl rand -base64 48
SOLVEIT_JWT_SECRET=

# Opcionais
# SOLVEIT_MAIL_FROM=solveit@localhost
# SOLVEIT_WEB_PORT=8080
